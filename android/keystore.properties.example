# Copy to keystore.properties (gitignored) to sign release builds with your own key.
# Without it, builds are signed with the Android debug key.
#
# Create a key:
#   keytool -genkeypair -v -keystore vivy-release.jks -alias vivy -keyalg RSA -keysize 2048 -validity 10000
storeFile=vivy-release.jks
storePassword=change-me
keyAlias=vivy
keyPassword=change-me
